# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=            # server + worker only, never shipped to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_PRICE_CREATOR=price_...         # recurring monthly price ids
STRIPE_PRICE_STUDIO=price_...

# --- AI ---------------------------------------------------------------------
# Clip selection: "anthropic" (direct) or "openrouter" (OpenAI-compatible). Auto-detected from keys.
CLIP_SELECTOR_PROVIDER=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# CLIP_SELECTOR_MODEL=claude-opus-5             # anthropic default
# CLIP_SELECTOR_MODEL=anthropic/claude-sonnet-5 # openrouter default

# Transcription: "openai" (whisper-1 API) or "local" (`pip install openai-whisper`). Auto-detected.
WHISPER_PROVIDER=
OPENAI_API_KEY=
WHISPER_MODEL=base
WHISPER_BIN=whisper

# --- Media ------------------------------------------------------------------
# Defaults to ffmpeg-static / ffprobe-static; set to use a system build.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Captions ---------------------------------------------------------------
CLIPKIT_CAPTION_STYLE=karaoke          # karaoke | boxed | pop | minimal
CLIPKIT_CAPTION_FONT=Liberation Sans
# CLIPKIT_CAPTION_SIZE=72              # overrides the preset size
